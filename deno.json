{
  "name": "@dreamer/console",
  "version": "1.0.7",
  "license": "Apache-2.0",
  "tasks": {
    "test": "deno test -A tests"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "LICENSE",
      "NOTICE",
      "README.md",
      "TEST_REPORT.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@dreamer/test": "jsr:@dreamer/test@^1.0.5",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.7"
  },
  "nodeModulesDir": "auto"
}
